void solve()
{

    ll n , x, y ;
    cin>>n>>x>>y ;

    vector<ll>v(n) , ans ;

    for(auto &u : v) cin>>u ;

    map<pair<ll, ll> , ll > m ;


    for(auto u :  v){
        ll a, b ;

        a  = u%x ;
        b  = u%y ;

        m[{a, b}]++;

    }


    ll aaaaa = 0 ;
    for (auto u : m){

        //cout<<u.first.first<<" "<<u.first.second<<" "<<u.second<<endl;

        ll a = u.first.first ;
        ll b = u.first.second ;
        ll c = u.second ;


        if(a == 0){

            aaaaa += (c*(c-1))/2 ;



        } else {

            ll diff = x - a ;



            ll p = m[{diff , b}]  ;// cout<<diff << " " <<b<<" "<<p<<endl;

             if(diff == a){
                aaaaa += (p*(p-1))/2 ;
                continue ;
             }

            aaaaa += (p*c) ;

            m[{diff , b}]-=p ;
            m[{a, b}] -= p ;

        }


    }





    cout<<aaaaa<<endl;

}




